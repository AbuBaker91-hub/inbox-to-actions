DATABASE_URL=postgresql://app:app@localhost:5432/app
GEMINI_API_KEY=            # required to run the demo with a real model
GROQ_API_KEY=              # optional fallback
LLM_PROVIDER_ORDER=gemini,groq
APP_RATE_LIMIT_PER_MIN=30  # protects free quotas on the public demo

# Optional project-specific settings
# LLM_PROVIDER_ORDER=mock  # offline demo: canned responses, zero keys needed
# INGEST_INTERVAL_S=30     # background ingest timer (0 disables it)
# INBOX_DIRS=samples/inbox,inbox
